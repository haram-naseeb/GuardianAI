# ─────────────────────────────────────────────────────────────────────────
# Guardian AI — example environment file
# Copy to `.env` (which is git-ignored, §28) and fill in as real services
# arrive. With the defaults below the whole app runs TODAY in mock mode with
# ZERO credentials.  NEVER put real secrets or patient data in this file.
# ─────────────────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────────────────
APP_ENV=development
DEBUG=true

# ── CORS: the frontend dev/preview origins allowed to call the API ─────────
# (comma-separated JSON-style list is parsed by pydantic-settings)
# CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# ── MASTER MOCK SWITCH ─────────────────────────────────────────────────────
# true  → every AI/RAG/speech/vision/location/notification provider is MOCKED.
#         This is the current MVP mode — no API keys required.
# false → each provider below is used for real (supply the credentials).
USE_MOCK_SERVICES=true

# ── Per-provider selection (only read when USE_MOCK_SERVICES=false) ─────────
# These are the seams for tomorrow's Alibaba Cloud / Qwen / Qoder integration.
LLM_PROVIDER=mock            # mock | qwen | openai | gemini
VISION_PROVIDER=mock         # mock | qwen-vl | gemini-vision
SPEECH_PROVIDER=mock         # mock | whisper | qwen-audio
RAG_PROVIDER=mock            # mock | faiss
LOCATION_PROVIDER=mock       # mock | maps
NOTIFICATION_PROVIDER=mock   # mock | (comms provider)

# ── Credentials (leave blank in mock mode; fill from your secret store) ────
# Do NOT hard-code real keys — supply them via your deployment's env/secrets.
LLM_API_KEY=
LLM_BASE_URL=                # e.g. Alibaba DashScope-compatible endpoint
LLM_MODEL=                   # e.g. qwen-max / qwen2.5-...
VISION_API_KEY=
VISION_MODEL=                # e.g. qwen-vl-max
EMBEDDINGS_MODEL=            # e.g. text-embedding-v3
MAPS_API_KEY=

# ── Knowledge base ─────────────────────────────────────────────────────────
KNOWLEDGE_BASE_DIR=../knowledge-base

# ── Frontend (Vite) ────────────────────────────────────────────────────────
# Leave VITE_API_BASE empty to use the dev-server proxy (recommended locally).
# Set it to an absolute URL only when the API is on a different origin.
# VITE_API_BASE=
# VITE_BACKEND_URL=http://localhost:8000   # proxy target used by vite dev
